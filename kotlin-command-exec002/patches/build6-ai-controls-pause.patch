diff --git a/app/src/main/java/com/nexarenew/aiconsole/domain/OutputTokenPolicy.kt b/app/src/main/java/com/nexarenew/aiconsole/domain/OutputTokenPolicy.kt
new file mode 100644
index 0000000000000000000000000000000000000000..a5ee2f492c3ae3969b421fe5fa8def93d46374a9
--- /dev/null
+++ b/app/src/main/java/com/nexarenew/aiconsole/domain/OutputTokenPolicy.kt
@@ -0,0 +1,12 @@
+package com.nexarenew.aiconsole.domain
+
+object OutputTokenPolicy {
+    const val MIN_TOKENS = 256
+    const val MAX_TOKENS = 1_048_576
+    const val STEP_TOKENS = 256
+
+    fun normalize(value: Int): Int {
+        val clamped = value.coerceIn(MIN_TOKENS, MAX_TOKENS)
+        return ((clamped / STEP_TOKENS) * STEP_TOKENS).coerceAtLeast(MIN_TOKENS)
+    }
+}
