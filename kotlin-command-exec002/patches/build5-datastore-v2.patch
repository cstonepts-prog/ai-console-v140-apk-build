diff --git a/app/src/main/java/com/nexarenew/aiconsole/settings/AppPreferences.kt b/app/src/main/java/com/nexarenew/aiconsole/settings/AppPreferences.kt
new file mode 100644
index 0000000000000000000000000000000000000000..5720f86d6dd07b96fd8e460ae6d9b5b1a75febc6
--- /dev/null
+++ b/app/src/main/java/com/nexarenew/aiconsole/settings/AppPreferences.kt
@@ -0,0 +1,41 @@
+package com.nexarenew.aiconsole.settings
+
+import android.content.Context
+import androidx.datastore.preferences.core.edit
+import androidx.datastore.preferences.core.stringPreferencesKey
+import androidx.datastore.preferences.preferencesDataStore
+import com.nexarenew.aiconsole.model.ProviderId
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.catch
+import kotlinx.coroutines.flow.map
+import java.io.IOException
+
+private val Context.kotlinCommandDataStore by preferencesDataStore(name = "kotlin_command_settings")
+
+class AppPreferences(context: Context) {
+    private val store = context.applicationContext.kotlinCommandDataStore
+
+    val lastWorkspaceId: Flow<String?> = value(LAST_WORKSPACE)
+    val preferredProvider: Flow<String?> = value(PREFERRED_PROVIDER)
+
+    fun preferredModel(provider: ProviderId): Flow<String?> = value(modelKey(provider))
+
+    suspend fun setLastWorkspaceId(id: String) = set(LAST_WORKSPACE, id)
+    suspend fun setPreferredProvider(provider: ProviderId) = set(PREFERRED_PROVIDER, provider.wire)
+    suspend fun setPreferredModel(provider: ProviderId, model: String) = set(modelKey(provider), model)
+
+    private fun value(key: androidx.datastore.preferences.core.Preferences.Key<String>): Flow<String?> =
+        store.data.catch { error -> if (error is IOException) emit(androidx.datastore.preferences.core.emptyPreferences()) else throw error }
+            .map { it[key] }
+
+    private suspend fun set(key: androidx.datastore.preferences.core.Preferences.Key<String>, value: String) {
+        store.edit { prefs -> prefs[key] = value }
+    }
+
+    private fun modelKey(provider: ProviderId) = stringPreferencesKey("preferred_model_${provider.wire}")
+
+    companion object {
+        private val LAST_WORKSPACE = stringPreferencesKey("last_workspace_id")
+        private val PREFERRED_PROVIDER = stringPreferencesKey("preferred_provider")
+    }
+}
